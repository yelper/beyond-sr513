<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Beyond SR 513</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  >
  <link href="/assets/styles.css" rel="stylesheet">
</head>
<body class="bg-light text-dark">
  <header class="bg-primary text-dark">
    <nav class="site-navbar navbar navbar-expand-lg bg-primary border-bottom">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/">Beyond SR 513</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#site-nav"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="site-nav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/about/">About</a></li>
            <li class="nav-item"><a class="nav-link" href="/history/">History</a></li>
            <li class="nav-item"><a class="nav-link" href="/get-involved/">Get Involved</a></li>
          </ul>
        </div>
      </div>
    </nav>
    <div class="container py-5">
      <div class="row justify-content-center text-center">
        <div class="col-lg-9">
          <h1 class="display-5 fw-bold">A complete Sand Point Way</h1>
          <p class="lead mb-0">Moving beyond the old state highway mindset and building a safer corridor for everyone in Northeast Seattle.</p>
        </div>
      </div>
    </div>
  </header>
  <main class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-9{% if contentClass %} {{ contentClass }}{% endif %}">
          {{ content | safe }}
        </div>
      </div>
    </div>
  </main>
  <footer class="border-top bg-white">
    <div class="container py-4 text-center text-body-secondary">
      <p class="mb-1">&copy; {{ year }} <a href="https://northeast.streetsalliance.org/" target="_blank">Northeast Safe Streets</a></p>
      <p class="mb-0"><a href="https://github.com/yelper/beyond-sr513">View source</a></p>
    </div>
  </footer>
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
</body>
</html>
