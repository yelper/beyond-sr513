<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Beyond SR 513</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Georgia, 'Times New Roman', serif;
      color: #222;
      background: #fafaf8;
      line-height: 1.7;
    }
    header {
      background: #1a5276;
      color: #fff;
      padding: 2rem 1rem;
      text-align: center;
    }
    header h1 { font-size: 2.2rem; letter-spacing: 0.02em; }
    header p  { font-size: 1.1rem; margin-top: 0.4rem; opacity: 0.85; }
    nav {
      background: #154360;
      display: flex;
      justify-content: center;
      gap: 2rem;
      padding: 0.6rem 1rem;
    }
    nav a { color: #aed6f1; text-decoration: none; font-size: 0.95rem; }
    nav a:hover { color: #fff; text-decoration: underline; }
    main {
      max-width: 800px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
    }
    h2 { font-size: 1.5rem; color: #1a5276; margin: 2rem 0 0.5rem; }
    p  { margin-bottom: 1rem; }
    footer {
      text-align: center;
      padding: 2rem 1rem;
      font-size: 0.85rem;
      color: #777;
      border-top: 1px solid #ddd;
      margin-top: 3rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>Beyond SR 513</h1>
    <p>Advocacy for a walkable Sand Point Way in Seattle</p>
  </header>
  <nav>
    <a href="/">Home</a>
    <a href="/about/">About</a>
    <a href="/get-involved/">Get Involved</a>
  </nav>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>&copy; {{ year }} Beyond SR 513 &mdash; <a href="https://github.com/yelper/beyond-sr513">View source on GitHub</a></p>
  </footer>
</body>
</html>
